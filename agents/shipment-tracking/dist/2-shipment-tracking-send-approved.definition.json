{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "connectionName": "shared-sharepointon-156e5799-77a0-4229-a580-2a265668e663",
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
        "tier": "NotSpecified"
      },
      "shared_office365": {
        "connectionName": "shared-office365-c3edd0cc-7252-442b-b870-19f9dc7f048c",
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_office365",
        "tier": "NotSpecified"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "When_a_row_is_approved": {
          "recurrence": {
            "frequency": "Minute",
            "interval": 1
          },
          "splitOn": "@triggerOutputs()?['body/value']",
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetOnUpdatedItems"
            },
            "parameters": {
              "dataset": "https://appriver3651010049.sharepoint.com/sites/SterlingBrokerageServices",
              "table": "Shipment Status Log"
            },
            "authentication": "@parameters('$authentication')"
          },
          "conditions": [
            {
              "expression": "@and(equals(triggerOutputs()?['body/SendState/Value'], 'Approved'), not(empty(triggerOutputs()?['body/Recipient'])))"
            }
          ]
        }
      },
      "actions": {
        "Send_to_customer": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "connectionName": "shared_office365",
              "operationId": "SendEmailV2"
            },
            "parameters": {
              "emailMessage/To": "@triggerOutputs()?['body/Recipient']",
              "emailMessage/Subject": "@triggerOutputs()?['body/DraftSubject']",
              "emailMessage/Body": "<p>@{replace(coalesce(triggerOutputs()?['body/DraftBody'], ''), decodeUriComponent('%0A'), '<br>')}</p>",
              "emailMessage/Importance": "Normal"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Mark_sent": {
          "runAfter": {
            "Send_to_customer": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "PatchItem"
            },
            "parameters": {
              "dataset": "https://appriver3651010049.sharepoint.com/sites/SterlingBrokerageServices",
              "table": "Shipment Status Log",
              "id": "@triggerOutputs()?['body/ID']",
              "item/Title": "@triggerOutputs()?['body/Title']",
              "item/SendState/Value": "Sent",
              "item/SentAt": "@utcNow()",
              "item/SentBy/Claims": "@triggerOutputs()?['body/Editor/Claims']"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Mark_held": {
          "runAfter": {
            "Send_to_customer": [
              "Failed",
              "TimedOut"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "PatchItem"
            },
            "parameters": {
              "dataset": "https://appriver3651010049.sharepoint.com/sites/SterlingBrokerageServices",
              "table": "Shipment Status Log",
              "id": "@triggerOutputs()?['body/ID']",
              "item/Title": "@triggerOutputs()?['body/Title']",
              "item/SendState/Value": "Held",
              "item/Reason": "Send failed @{utcNow()}: @{coalesce(outputs('Send_to_customer')?['body']?['error']?['message'], 'see run history')}"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "outputs": {}
    }
  },
  "schemaVersion": "1.0.0.0"
}